# Franklin.bet — generator config
#
# The generator (scripts/generate.mjs) calls the BlockRun gateway through the
# @blockrun/llm SDK. Your wallet signature is your auth — no API keys.

# Base-chain wallet private key used to sign x402 micropayments.
# The flagship council models are paid (a few $0.001 calls per run).
# Leave unset and run `npm run generate:free` to use the free NVIDIA tier instead.
BASE_CHAIN_WALLET_KEY=

# Optional: point at a non-production gateway.
# BLOCKRUN_BASE_URL=https://blockrun.ai

# Optional: "flagship" (default) or "free" (NVIDIA zero-USDC tier)
ORACLE_TIER=flagship

# Agent (grounded) engine only — the Franklin CLI is a SYSTEM tool, not an npm
# dependency. Install it (`npm i -g @blockrun/franklin`, needs `franklin predict`)
# so `franklin` is on PATH, or point FRANKLIN_CMD at a local build:
# FRANKLIN_CMD="node /path/to/Franklin/dist/index.js"
